RewriteEngine On

# =====================================================
# BASE DEL PROYECTO
# =====================================================

RewriteBase /Malku/public/

# =====================================================
# ERRORES HTTP — pasar por el router para mostrar
# páginas con el diseño del sitio
# =====================================================

ErrorDocument 404 /Malku/public/index.php?url=_error_404
ErrorDocument 403 /Malku/public/index.php?url=_error_403
ErrorDocument 500 /Malku/public/index.php?url=_error_500

# =====================================================
# SI EXISTE ARCHIVO O CARPETA, NO REESCRIBIR
# =====================================================

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# =====================================================
# REDIRIGIR TODO A INDEX.PHP
# =====================================================

RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]